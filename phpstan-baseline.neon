# Findings PHPStan cannot see past, each with the reason it is not a problem.
# Nothing real belongs here: a finding that points at a bug is fixed in the code.
parameters:
    ignoreErrors:
        # array( 'redirect', 1 ) is a valid proc_open() descriptor since PHP 7.4
        # (stderr to wherever stdout goes), and PHP requires the target to be an
        # int; PHPStan's signature of proc_open() allows only list<string> or a
        # resource, and a stub cannot replace it (PHPStan declares the function in
        # its own stubs).
        -
            identifier: argument.type
            message: '#^Parameter \#2 \$descriptor_spec of function proc_open expects#'
            path: classes/runnable/commands/php_package.php
            count: 1

        # PHP_BINARY is '' when PHP cannot determine its own binary (some
        # embedded SAPIs); PHPStan types the constant as non-empty.
        -
            identifier: notIdentical.alwaysTrue
            message: '#^Strict comparison using \!\=\= between non\-falsy\-string and '''' will always evaluate to true\.$#'
            path: classes/xrowextractjob.php
            count: 1
